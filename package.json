{
  "name": "borstenboom",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "test:sim": "node --test tests/simulation.test.mjs",
    "test:e2e": "playwright test",
    "assets:check": "node tools/assets/validate.mjs assets",
